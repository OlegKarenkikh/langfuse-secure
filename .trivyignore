# .trivyignore — обоснованные исключения
# ===========================================================

# --- FALSE POSITIVES: GCP service-account UI template ---
# Langfuse web содержит UI-компонент для ввода GCP credentials.
# Trivy детектирует JSON-шаблон в Next.js chunks как утечку секрета.
# Это не реальные секреты — placeholder-значения без реальных данных.
# Verified: web/.next/server/chunks/4803.js, web/.next/static/chunks/2348-*.js
secret/gcp-service-account

# ===========================================================
# --- esbuild golang stdlib (build-stage only) ---
# ===========================================================
# esbuild является dev-инструментом и не вызывается в production runtime.
CVE-2025-68121
CVE-2025-47907
CVE-2025-58183
CVE-2025-61726
CVE-2025-61728
CVE-2025-61729

# ===========================================================
# --- npm build-stage only: rollup, serialize-javascript ---
# ===========================================================

# rollup: Path Traversal RCE
# Используется только как bundler в build-stage (Next.js webpack). В runtime отсутствует.
# Fix: 4.59.0 | https://avd.aquasec.com/nvd/cve-2026-27606
CVE-2026-27606

# serialize-javascript: RCE via RegExp.flags
# Транзитивная зависимость webpack/terser, только build-stage. Fix: 7.0.3
# https://github.com/advisories/GHSA-5c6j-r48x-rmvq
GHSA-5c6j-r48x-rmvq

# ===========================================================
# --- WEB image: npm runtime CVEs ---
